{
  "name": "@obiba/quasar-ui-json-form",
  "version": "0.7.3",
  "author": "Yannick Marcon <yannick.marcon@obiba.org>",
  "description": "Quasar components for JSON Forms",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/obiba/quasar-json-form"
  },
  "bugs": {
    "url": "https://github.com/obiba/quasar-json-form/issues"
  },
  "homepage": "https://www.obiba.org/quasar-json-form/",
  "module": "dist/index.esm.js",
  "main": "dist/index.common.js",
  "types": "dist/index.esm.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.esm.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.common.js"
    },
    "./asf": {
      "types": "./dist/asf/index.d.ts",
      "import": "./dist/asf.esm.js",
      "require": "./dist/asf.common.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog.esm.js",
      "require": "./dist/catalog.common.js"
    },
    "./builder": {
      "types": "./dist/builder/index.d.ts",
      "import": "./dist/builder.esm.js",
      "require": "./dist/builder.common.js"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "cd dev && npm run dev && cd ..",
    "dev:umd": "npm run build && node build/script.open-umd.js",
    "build": "node build/index.js && npm run build:types",
    "build:js": "node build/script.javascript.js",
    "build:css": "node build/script.css.js",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@jsonforms/core": "^3.7.0",
    "@jsonforms/vue": "^3.7.0",
    "@jsonforms/vue-vanilla": "^3.7.0",
    "angular-expressions": "^1.6.0",
    "dompurify": "^3.3.1",
    "markdown-it": "^14.1.0",
    "ol": "^10.10.0",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@rollup/plugin-buble": "^1.0.3",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.5",
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/sortablejs": "^1.15.9",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "autoprefixer": "^10.4.16",
    "chalk": "^4.1.2",
    "cssnano": "^6.0.0",
    "fs-extra": "^11.2.0",
    "jsdom": "^26.1.0",
    "open": "^10.0.0",
    "postcss": "^8.4.32",
    "rimraf": "^5.0.5",
    "rollup": "^4.9.0",
    "rtlcss": "^4.1.1",
    "sass": "^1.69.5",
    "tslib": "^2.6.0",
    "typescript": "^5.8.3",
    "uglify-js": "^3.17.4",
    "vite": "^6.4.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.0"
  },
  "peerDependencies": {
    "quasar": "^2.0.0",
    "vue": "^3.0.0",
    "vue-i18n": "^11.2.2"
  },
  "browserslist": [
    "last 4 Chrome versions",
    "last 4 Firefox versions",
    "last 2 Edge versions",
    "last 4 Safari versions",
    "last 4 Android versions",
    "last 4 ChromeAndroid versions",
    "last 4 FirefoxAndroid versions",
    "last 4 iOS versions"
  ]
}
