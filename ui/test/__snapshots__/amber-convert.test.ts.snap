        "label": "Validations",
        "type": "Group",
      },
      {
        "description": "A condition is a rule that drives the visibility of a field. When a field is not visible there is no value associated.",
        "elements": [
          {
            "options": {
              "format": "radio",
            },
            "scope": "#/properties/CONDITIONS/properties/YESNO",
            "type": "Control",
          },
          {
            "rules": {
              "visible": "CONDITIONS.YESNO === '1'",
            },
            "scope": "#/properties/CONDITIONS/properties/YES",
            "type": "Control",
          },
          {
            "description": "Ok, you said No, let's forget it then.",
            "rules": {
