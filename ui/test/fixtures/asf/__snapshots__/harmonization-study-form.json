{
  "schema": {
    "type": "object",
    "properties": {
      "startYear": {
        "type": "integer",
        "title": "study.start-year"
      },
      "endYear": {
        "type": "integer",
        "title": "study.end-year"
      },
      "additionalInformation": {
        "type": "object",
        "format": "obibaSimpleMde",
        "title": "global.additional-information"
      },
      "_name": {
        "title": "harmonization-initiative.name",
        "type": "object",
        "format": "localizedString"
      },
      "_acronym": {
        "title": "harmonization-initiative.acronym",
        "type": "object",
        "format": "localizedString"
      },
      "_objectives": {
        "title": "harmonization-initiative.objectives",
        "type": "object",
        "format": "obibaSimpleMde"
      },
      "_opal": {
        "title": "harmonization-initiative.opal",
        "type": "string",
        "pattern": "^https?://[a-zA-Z0-9._/?&=:%-]+$"
      }
    },
    "required": [
      "_name",
      "_acronym",
      "_objectives"
    ]
  },
  "uischema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Label",
        "text": "<h3>study.general-info</h3>"
      },
      {
        "type": "VerticalLayout",
        "elements": [
          {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/_name",
                "hint": "harmonization-initiative.name-help"
              },
              {
                "type": "Control",
                "scope": "#/properties/_acronym",
                "hint": "harmonization-initiative.acronym-help"
              },
              {
                "type": "Control",
                "scope": "#/properties/_opal",
                "hint": "harmonization-initiative.opal-help"
              }
            ],
            "options": {
              "class": "col-6"
            }
          },
          {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/_objectives",
                "hint": "harmonization-initiative.objectives-help",
                "options": {
                  "marked": true,
                  "rows": 3
                }
              }
            ],
            "options": {
              "class": "col-6"
            }
          }
        ],
        "options": {
          "class": "row q-col-gutter-md"
        }
      },
      {
        "type": "Group",
        "elements": [
          {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "VerticalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/startYear"
                  }
                ],
                "options": {
                  "class": "col-12 col-md-6"
                }
              },
              {
                "type": "VerticalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/endYear"
                  }
                ],
                "options": {
                  "class": "col-12 col-md-6"
                }
              }
            ],
            "options": {
              "class": "row q-col-gutter-md"
            }
          }
        ]
      },
      {
        "type": "Control",
        "scope": "#/properties/additionalInformation",
        "options": {
          "marked": true
        }
      }
    ]
  }
}
