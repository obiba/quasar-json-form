{
  "schema": {
    "type": "object",
    "properties": {
      "grantSubmission": {
        "title": "data-access-feasibility.default.grant-submission.check",
        "type": "boolean"
      },
      "grantingAgency": {
        "title": "data-access-feasibility.default.granting-agency",
        "type": "string"
      },
      "grantCompetition": {
        "title": "data-access-feasibility.default.grant-competition",
        "type": "string"
      },
      "grantDate": {
        "title": "data-access-feasibility.default.grant-date",
        "type": "string",
        "format": "datepicker"
      },
      "pi": {
        "title": "data-access-feasibility.default.pi",
        "type": "string"
      },
      "career": {
        "title": "data-access-feasibility.default.career.title",
        "type": "string",
        "oneOf": [
          {
            "const": "inv-early",
            "title": "data-access-feasibility.default.career.inv-early"
          },
          {
            "const": "inv-mid",
            "title": "data-access-feasibility.default.career.inv-mid"
          },
          {
            "const": "inv-senior",
            "title": "data-access-feasibility.default.career.inv-senior"
          },
          {
            "const": "student",
            "title": "data-access-feasibility.default.career.student"
          },
          {
            "const": "postdoc",
            "title": "data-access-feasibility.default.career.postdoc"
          },
          {
            "const": "other",
            "title": "data-access-feasibility.default.career.other"
          }
        ]
      },
      "careerOther": {
        "title": "data-access-feasibility.default.career.other-career",
        "type": "string"
      },
      "currentPosition": {
        "title": "data-access-feasibility.default.current-position",
        "type": "string"
      },
      "piEmail": {
        "title": "data-access-feasibility.default.pi-email",
        "type": "string",
        "pattern": "^\\S+@\\S+$"
      },
      "piPhone": {
        "title": "data-access-feasibility.default.pi-phone",
        "type": "string"
      },
      "piAddress": {
        "title": "data-access-feasibility.default.pi-address",
        "type": "string"
      },
      "projectTitle": {
        "title": "data-access-feasibility.default.project-title",
        "type": "string"
      },
      "projectObjectives": {
        "title": "data-access-feasibility.default.project-objectives",
        "type": "string"
      },
      "datasets": {
        "title": "data-access-feasibility.default.datasets",
        "type": "string"
      },
      "selectionCriteria": {
        "title": "data-access-feasibility.default.selection-criteria",
        "type": "string"
      },
      "studyDesign": {
        "title": "data-access-feasibility.default.study-design",
        "type": "string"
      },
      "includeBiospecimens": {
        "title": "data-access-feasibility.default.biospecimens.check",
        "type": "boolean"
      },
      "biospecimensType": {
        "title": "data-access-feasibility.default.biospecimens-type",
        "type": "string"
      },
      "biospecimensSelectionCriteria": {
        "title": "data-access-feasibility.default.biospecimens-selection-criteria",
        "type": "string"
      },
      "biospecimensPreAnalyticalCharacteristics": {
        "title": "data-access-feasibility.default.biospecimens-pre-analytical-characteristics",
        "type": "string"
      },
      "biospecimensAnalyzeMethods": {
        "title": "data-access-feasibility.default.biospecimens-analyze-methods",
        "type": "string"
      },
      "linkage": {
        "title": "data-access-feasibility.default.data-linkage",
        "type": "string"
      }
    },
    "required": [
      "pi",
      "career",
      "currentPosition",
      "piEmail",
      "piPhone",
      "piAddress",
      "projectTitle",
      "projectObjectives",
      "datasets",
      "selectionCriteria",
      "studyDesign",
      "grantingAgency",
      "grantDate",
      "grantCompetition",
      "careerOther",
      "biospecimensType",
      "biospecimensSelectionCriteria",
      "biospecimensAnalyzeMethods"
    ]
  },
  "uischema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Group",
        "elements": [
          {
            "type": "Label",
            "text": "<h3>data-access-feasibility.default.grant-submission.title</h3>"
          },
          {
            "type": "Control",
            "scope": "#/properties/grantSubmission"
          }
        ]
      },
      {
        "type": "Group",
        "elements": [
          {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "VerticalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/grantingAgency"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/grantDate",
                    "options": {
                      "validationMessage": "data-access-request.default.date-error",
                      "dateOptions": {
                        "dateFormat": "yyyy-MM-dd"
                      }
                    }
                  }
                ],
                "options": {
                  "class": "col-6"
                }
              },
              {
                "type": "VerticalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/grantCompetition"
                  }
                ],
                "options": {
                  "class": "col-6"
                }
              }
            ],
            "options": {
              "class": "row q-col-gutter-md"
            }
          }
        ],
        "rules": {
          "visible": "!!grantSubmission"
        }
      },
      {
        "type": "Group",
        "elements": [
          {
            "type": "Label",
            "text": "<h3>data-access-feasibility.default.applicant-info.title</h3>"
          }
        ]
      },
      {
        "type": "Group",
        "elements": [
          {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "VerticalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/pi"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/career",
                    "options": {
                      "format": "radio"
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/careerOther",
                    "rules": {
                      "visible": "career === \"other\""
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/currentPosition"
                  }
                ],
                "options": {
                  "class": "col-6"
                }
              },
              {
                "type": "VerticalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/piEmail"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/piPhone"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/piAddress",
                    "options": {
                      "rows": 3
                    }
                  }
                ],
                "options": {
                  "class": "col-6"
                }
              }
            ],
            "options": {
              "class": "row q-col-gutter-md"
            }
          }
        ]
      },
      {
        "type": "Group",
        "elements": [
          {
            "type": "Label",
            "text": "<h3>data-access-feasibility.default.project-info.title</h3>"
          }
        ]
      },
      {
        "type": "Group",
        "elements": [
          {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "VerticalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/projectTitle"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/projectObjectives",
                    "options": {
                      "rows": 3
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Group",
        "elements": [
          {
            "type": "Label",
            "text": "<h3>data-access-feasibility.default.data.title</h3>"
          }
        ]
      },
      {
        "type": "Group",
        "elements": [
          {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "VerticalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/datasets",
                    "options": {
                      "rows": 3
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/selectionCriteria",
                    "options": {
                      "rows": 3
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/studyDesign",
                    "options": {
                      "rows": 3
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Group",
        "elements": [
          {
            "type": "Label",
            "text": "<h3>data-access-feasibility.default.biospecimens.title</h3>"
          },
          {
            "type": "Control",
            "scope": "#/properties/includeBiospecimens"
          }
        ]
      },
      {
        "type": "Group",
        "elements": [
          {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "VerticalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/biospecimensType",
                    "options": {
                      "rows": 3
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/biospecimensSelectionCriteria",
                    "options": {
                      "rows": 3
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/biospecimensPreAnalyticalCharacteristics",
                    "options": {
                      "rows": 3
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/biospecimensAnalyzeMethods",
                    "options": {
                      "rows": 3
                    }
                  }
                ]
              }
            ]
          }
        ],
        "rules": {
          "visible": "!!includeBiospecimens"
        }
      },
      {
        "type": "Group",
        "elements": [
          {
            "type": "Label",
            "text": "<h3>data-access-feasibility.default.linkage.title</h3>"
          }
        ]
      },
      {
        "type": "Group",
        "elements": [
          {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "VerticalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/linkage",
                    "options": {
                      "rows": 3
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
