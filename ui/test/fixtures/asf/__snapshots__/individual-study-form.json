                "options": {
                  "class": "col-md-6"
                }
              }
            ],
            "options": {
              "class": "row q-col-gutter-md"
            }
          },
          {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/access_restrictions"
