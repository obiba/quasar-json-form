                "type": "VerticalLayout",
                "elements": [
                  {
                    "type": "VerticalLayout",
                    "elements": [
                      {
                        "type": "VerticalLayout",
                        "elements": [
                          {
                            "type": "Label",
                            "text": "<label>study_taxonomy.vocabulary.access_data.title</label>"
                          },
                          {
                            "type": "Control",
                            "scope": "#/properties/access_permission_data",
                            "label": false
                          },
                          {
                            "type": "Label",
                            "text": "<label>study_taxonomy.vocabulary.access_bio_samples.title</label>"
                          },
                          {
                            "type": "Control",
                            "scope": "#/properties/access_permission_biological_samples",
                            "label": false
                          },
