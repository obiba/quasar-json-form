                              "rows": 2
                            }
                          }
                        ],
                        "options": {
                          "class": "col-6"
                        }
                      },
                      {
                        "type": "VerticalLayout",
                        "elements": [
                          {
                            "type": "Label",
                            "text": "<label>study.access.access_restrictions.transfer.title</label>"
                          },
                          {
                            "type": "Control",
                            "scope": "#/properties/access_data_can_leave"
