            "options": {
              "class": "col-12"
            },
            "rules": {
              "visible": "access.access_data == \"yes\" or access.access_bio_samples == \"yes\" or access.access_other == \"yes\""
            }
          },
          {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "Label",
                "text": "<h4>study.access.access_restrictions.title</h4>"
              },
              {
                "type": "Label",
                "text": "<label>study.access.access_restrictions.sector-of-research.title</label>"
              },
