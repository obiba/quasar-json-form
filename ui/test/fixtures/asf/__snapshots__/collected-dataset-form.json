{
  "schema": {
    "type": "object",
    "properties": {
      "_name": {
        "title": "dataset.name",
        "type": "object",
        "format": "localizedString"
      },
      "_acronym": {
        "title": "dataset.acronym",
        "type": "object",
        "format": "localizedString"
      },
      "_description": {
        "title": "dataset.description",
        "type": "object",
        "format": "obibaSimpleMde"
      },
      "_entityType": {
