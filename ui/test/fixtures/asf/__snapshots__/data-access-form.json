{
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "data-access-request.default.name",
        "type": "string"
      },
      "title": {
        "title": "data-access-request.default.title",
        "type": "string"
      },
      "position": {
        "title": "data-access-request.default.position",
        "type": "string"
      },
      "institution": {
        "title": "data-access-request.default.institution",
        "type": "string"
      },
      "email": {
        "title": "data-access-request.default.institution-email",
        "type": "string",
        "pattern": "^\\S+@\\S+$"
      },
      "emailAlt": {
        "title": "data-access-request.default.email-alt",
        "type": "string",
        "pattern": "^\\S+@\\S+$"
      },
      "mailingAddress": {
        "title": "data-access-request.default.address",
        "type": "string"
      },
      "phone": {
        "title": "data-access-request.default.phone",
        "type": "string"
      },
      "repName": {
        "title": "data-access-request.default.name",
        "type": "string"
      },
      "repTitle": {
        "title": "data-access-request.default.title",
        "type": "string"
      },
      "repPosition": {
        "title": "data-access-request.default.position",
        "type": "string"
      },
      "repInstitution": {
        "title": "data-access-request.default.institution",
        "type": "string"
      },
      "repEmail": {
        "title": "data-access-request.default.institution-email",
        "type": "string",
        "pattern": "^\\S+@\\S+$"
      },
      "repMailingAddress": {
        "title": "data-access-request.default.address",
        "type": "string"
      },
      "repPhone": {
        "title": "data-access-request.default.phone",
        "type": "string"
      },
      "projectTitle": {
        "type": "string"
      },
      "projectWebsite": {
        "title": "data-access-request.default.I.C.website",
        "type": "string",
        "pattern": "^https?://\\S+$",
        "description": "data-access-request.default.I.C.website-help"
      },
      "hasNoStaff": {
        "title": "data-access-request.default.I.D.check",
        "type": "boolean"
      },
      "staff": {
        "type": "array",
        "maxItems": 5,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "data-access-request.default.name",
              "type": "string"
            },
            "title": {
              "title": "data-access-request.default.title",
              "type": "string"
            },
            "position": {
              "title": "data-access-request.default.position",
              "type": "string"
            },
            "email": {
              "title": "data-access-request.default.email",
              "type": "string",
              "pattern": "^\\S+@\\S+$"
            }
          },
          "required": [
            "name",
            "email"
          ]
        }
      },
      "hasNoStudents": {
        "title": "data-access-request.default.I.E.check",
        "type": "boolean"
      },
      "students": {
        "type": "array",
        "maxItems": 5,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "data-access-request.default.name",
              "type": "string"
            },
            "title": {
              "title": "data-access-request.default.title",
              "type": "string"
            },
            "position": {
              "title": "data-access-request.default.position",
              "type": "string"
            },
            "email": {
              "title": "data-access-request.default.email",
              "type": "string",
              "pattern": "^\\S+@\\S+$"
            }
          },
          "required": [
            "name",
            "email"
          ]
        }
      },
      "abstract": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      },
      "endDate": {
        "type": "string",
        "format": "datepicker"
      },
      "rdRebResearchProtocol": {
        "type": "object",
        "format": "obibaFiles",
        "title": "data-access-request.default.documents.reb-research-protocol"
      },
      "rdRebDecisionLetter": {
        "type": "object",
        "format": "obibaFiles",
        "title": "data-access-request.default.documents.reb-decision-letter"
      },
      "rdCV": {
        "type": "object",
        "format": "obibaFiles",
        "title": "data-access-request.default.documents.cv"
      },
      "rdPeerReview": {
        "type": "object",
        "format": "obibaFiles",
        "title": "data-access-request.default.documents.peer-review"
      },
      "isFormCompleted": {
        "title": "data-access-request.default.signature.check",
        "type": "boolean"
      }
    },
    "required": [
      "name",
      "email",
      "repName",
      "repEmail",
      "projectTitle",
      "abstract",
      "summary",
      "endDate",
      "rdRebResearchProtocol",
      "rdRebDecisionLetter",
      "rdCV",
      "isFormCompleted"
    ]
  },
  "uischema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Label",
        "text": "<h2>I - data-access-request.default.I.title</h2>"
      },
      {
        "type": "Group",
        "elements": [
          {
            "type": "Label",
            "text": "<h3>A. data-access-request.default.I.A.title</h3><p class='help-block'>data-access-request.default.I.A.info</p>"
          },
          {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "VerticalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/name"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/title"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/position"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/institution"
                  }
                ],
                "options": {
                  "class": "col-6"
                }
              },
              {
                "type": "VerticalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/email"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/emailAlt"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/phone"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/mailingAddress",
                    "options": {
                      "rows": 3
                    }
                  }
                ],
                "options": {
                  "class": "col-6"
                }
              }
            ],
            "options": {
              "class": "row q-col-gutter-md"
            }
          }
        ]
      },
      {
        "type": "Group",
        "elements": [
          {
            "type": "Label",
            "text": "<h3>B. data-access-request.default.I.B.title</h3><p class='help-block'>data-access-request.default.I.B.info</p>"
          },
          {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "VerticalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/repName"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/repTitle"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/repPosition"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/repInstitution"
                  }
                ],
                "options": {
                  "class": "col-6"
                }
              },
              {
                "type": "VerticalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/repEmail"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/repPhone"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/repMailingAddress",
                    "options": {
                      "rows": 3
                    }
                  }
                ],
                "options": {
                  "class": "col-6"
                }
              }
            ],
            "options": {
              "class": "row q-col-gutter-md"
            }
          }
        ]
      },
      {
        "type": "Group",
        "elements": [
          {
            "type": "Label",
            "text": "<h3>C. data-access-request.default.I.C.title</h3>"
          },
          {
            "type": "Control",
            "scope": "#/properties/projectTitle",
            "label": false,
            "options": {
              "rows": 3
            }
          },
          {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "VerticalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/projectWebsite"
                  }
                ],
                "options": {
                  "class": "col-6"
                }
              },
              {
                "type": "VerticalLayout",
                "elements": [],
                "options": {
                  "class": "col-6"
                }
              }
            ],
            "options": {
              "class": "row q-col-gutter-md"
            }
          }
        ]
      },
      {
        "type": "Label",
        "text": "<h3>D. data-access-request.default.I.D.title</h3><p class='help-block'>data-access-request.default.I.D.info</p>"
      },
      {
        "type": "VerticalLayout",
        "elements": [
          {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/hasNoStaff"
              },
              {
                "type": "Control",
                "scope": "#/properties/staff",
                "label": false,
                "options": {
                  "addLabel": "New",
                  "items": {
                    "type": "VerticalLayout",
                    "elements": [
                      {
                        "type": "Control",
                        "scope": "#/properties/name"
                      },
                      {
                        "type": "Control",
                        "scope": "#/properties/title"
                      },
                      {
                        "type": "Control",
                        "scope": "#/properties/position"
                      },
                      {
                        "type": "Control",
                        "scope": "#/properties/email"
                      }
                    ]
                  }
                },
                "rules": {
                  "visible": "not (truthy(hasNoStaff))"
                }
              }
            ],
            "options": {
              "class": "col-6"
            }
          },
          {
            "type": "VerticalLayout",
            "elements": [],
            "options": {
              "class": "col-6"
            }
          }
        ],
        "options": {
          "class": "row q-col-gutter-md"
        }
      },
      {
        "type": "Label",
        "text": "<h3>E. data-access-request.default.I.E.title</h3><p class='help-block'>data-access-request.default.I.E.info</p>"
      },
      {
        "type": "VerticalLayout",
        "elements": [
          {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/hasNoStudents"
              },
              {
                "type": "Control",
                "scope": "#/properties/students",
                "label": false,
                "options": {
                  "addLabel": "New",
                  "items": {
                    "type": "VerticalLayout",
                    "elements": [
                      {
                        "type": "Control",
                        "scope": "#/properties/name"
                      },
                      {
                        "type": "Control",
                        "scope": "#/properties/title"
                      },
                      {
                        "type": "Control",
                        "scope": "#/properties/position"
                      },
                      {
                        "type": "Control",
                        "scope": "#/properties/email"
                      }
                    ]
                  }
                },
                "rules": {
                  "visible": "not (truthy(hasNoStudents))"
                }
              }
            ],
            "options": {
              "class": "col-6"
            }
          },
          {
            "type": "VerticalLayout",
            "elements": [],
            "options": {
              "class": "col-6"
            }
          }
        ],
        "options": {
          "class": "row q-col-gutter-md"
        }
      },
      {
        "type": "Group",
        "elements": [
          {
            "type": "Label",
            "text": "<h3>F. data-access-request.default.I.F.title</h3><p class='help-block'>data-access-request.default.I.F.info</p>"
          },
          {
            "type": "Control",
            "scope": "#/properties/abstract",
            "label": false,
            "options": {
              "rows": 3,
              "wordLimit": "0:500",
              "validationMessage": {
                "wordLimitError": "The 500 words limit has been exceeded."
              }
            }
          }
        ]
      },
      {
        "type": "Group",
        "elements": [
          {
            "type": "Label",
            "text": "<h3>G. data-access-request.default.I.G.title</h3><p class='help-block'>data-access-request.default.I.G.info</p>"
          },
          {
            "type": "Control",
            "scope": "#/properties/summary",
            "label": false,
            "options": {
              "rows": 3,
              "wordLimit": "0:200",
              "validationMessage": {
                "wordLimitError": "The 200 words limit has been exceeded."
              }
            }
          }
        ]
      },
      {
        "type": "Group",
        "elements": [
          {
            "type": "Label",
            "text": "<h3>H. data-access-request.default.I.H.title</h3><p class='help-block'>data-access-request.default.I.H.info</p>"
          },
          {
            "type": "Control",
            "scope": "#/properties/endDate",
            "label": false,
            "options": {
              "validationMessage": "data-access-request.default.date-error",
              "dateOptions": {
                "dateFormat": "yyyy-MM-dd"
              }
            }
          }
        ]
      },
      {
        "type": "Label",
        "text": "<h2>II - data-access-request.default.documents.title</h2>"
      },
      {
        "type": "Group",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/rdRebResearchProtocol",
            "options": {
              "emptyMessage": "data-access-request.no-documents",
              "validationMessage": {
                "missingFiles": "missing-files",
                "minItems": "min-items"
              }
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/rdRebDecisionLetter",
            "options": {
              "emptyMessage": "data-access-request.no-documents",
              "validationMessage": {
                "missingFiles": "missing-files",
                "minItems": "min-items"
              }
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/rdCV",
            "options": {
              "emptyMessage": "data-access-request.no-documents",
              "validationMessage": {
                "missingFiles": "missing-files",
                "minItems": "min-items"
              }
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/rdPeerReview",
            "options": {
              "emptyMessage": "data-access-request.no-documents",
              "validationMessage": {
                "missingFiles": "missing-files",
                "minItems": "min-items"
              }
            }
          }
        ]
      },
      {
        "type": "Group",
        "elements": [
          {
            "type": "Label",
            "text": "<h3>data-access-request.default.signature.title</h3>"
          },
          {
            "type": "Control",
            "scope": "#/properties/isFormCompleted"
          }
        ]
      }
    ]
  }
}
