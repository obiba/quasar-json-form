{
  "schema": {
    "type": "object",
    "properties": {
      "modificationNature": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "IA",
            "IB",
            "IC",
            "ID",
            "IE",
            "IF",
            "IG",
            "IH",
            "IIrdRebResearchProtocol",
            "IIrdRebDecisionLetter",
            "IIrdCV",
            "IIrdPeerReview",
            "other"
          ]
        }
      },
      "name": {
        "title": "t(data-access-amendment.default.name)",
        "type": "string"
      },
      "title": {
        "title": "t(data-access-amendment.default.title)",
        "type": "string"
      },
      "position": {
        "title": "t(data-access-amendment.default.position)",
        "type": "string"
      },
      "institution": {
        "title": "t(data-access-amendment.default.institution)",
        "type": "string"
      },
      "email": {
        "title": "t(data-access-amendment.default.institution-email)",
        "type": "string",
        "pattern": "^\\S+@\\S+$"
      },
      "emailAlt": {
        "title": "t(data-access-amendment.default.email-alt)",
        "type": "string",
        "pattern": "^\\S+@\\S+$"
      },
      "mailingAddress": {
        "title": "t(data-access-amendment.default.address)",
        "type": "string"
      },
      "phone": {
        "title": "t(data-access-amendment.default.phone)",
        "type": "string"
      },
      "repName": {
        "title": "t(data-access-amendment.default.name)",
        "type": "string"
      },
      "repTitle": {
        "title": "t(data-access-amendment.default.title)",
        "type": "string"
      },
      "repPosition": {
        "title": "t(data-access-amendment.default.position)",
        "type": "string"
      },
      "repInstitution": {
        "title": "t(data-access-amendment.default.institution)",
        "type": "string"
      },
      "repEmail": {
        "title": "t(data-access-amendment.default.institution-email)",
        "type": "string",
        "pattern": "^\\S+@\\S+$"
      },
      "repMailingAddress": {
        "title": "t(data-access-amendment.default.address)",
        "type": "string"
      },
      "repPhone": {
        "title": "t(data-access-amendment.default.phone)",
        "type": "string"
      },
      "projectTitle": {
        "type": "string"
      },
      "projectWebsite": {
        "title": "t(data-access-amendment.default.I.C.website)",
        "type": "string"
      },
      "hasNoStaff": {
        "title": "t(data-access-amendment.default.I.D.check)",
        "type": "boolean"
      },
      "staff": {
        "type": "array",
        "maxItems": 5,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "t(data-access-amendment.default.name)",
              "type": "string"
            },
            "title": {
              "title": "t(data-access-amendment.default.title)",
              "type": "string"
            },
            "position": {
              "title": "t(data-access-amendment.default.position)",
              "type": "string"
            },
            "email": {
              "title": "t(data-access-amendment.default.email)",
              "type": "string",
              "pattern": "^\\S+@\\S+$"
            }
          },
          "required": [
            "name",
            "email"
          ]
        }
      },
      "hasNoStudents": {
        "title": "t(data-access-amendment.default.I.E.check)",
        "type": "boolean"
      },
      "students": {
        "type": "array",
        "maxItems": 5,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "t(data-access-amendment.default.name)",
              "type": "string"
            },
            "title": {
              "title": "t(data-access-amendment.default.title)",
              "type": "string"
            },
            "position": {
              "title": "t(data-access-amendment.default.position)",
              "type": "string"
            },
            "email": {
              "title": "t(data-access-amendment.default.email)",
              "type": "string",
              "pattern": "^\\S+@\\S+$"
            }
          },
          "required": [
            "name",
            "email"
          ]
        }
      },
      "abstract": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      },
      "endDate": {
        "type": "string",
        "format": "datepicker"
      },
      "other": {
        "title": "t(data-access-amendment.default.other-modifications)",
        "type": "string"
      },
      "rdRebResearchProtocol": {
        "type": "object",
        "format": "obibaFiles",
        "title": "t(data-access-amendment.default.documents.reb-research-protocol)"
      },
      "rdRebDecisionLetter": {
        "type": "object",
        "format": "obibaFiles",
        "title": "t(data-access-amendment.default.documents.reb-decision-letter)"
      },
      "rdCV": {
        "type": "object",
        "format": "obibaFiles",
        "title": "t(data-access-amendment.default.documents.cv)"
      },
      "rdPeerReview": {
        "type": "object",
        "format": "obibaFiles",
        "title": "t(data-access-amendment.default.documents.peer-review)"
      },
      "isFormCompleted": {
        "title": "t(data-access-amendment.default.signature.check)",
        "type": "boolean"
      }
    },
    "required": [
      "isFormCompleted"
    ]
  },
  "definition": [
    {
      "type": "help",
      "helpvalue": "<h2>t(data-access-amendment.default.form-title)</h2>"
    },
    {
      "type": "fieldset",
      "items": [
        {
          "type": "help",
          "helpvalue": "<h3>t(data-access-amendment.default.modification-nature-title)</h3>"
        },
        {
          "key": "modificationNature",
          "type": "checkboxes",
          "required": true,
          "notitle": true,
          "titleMap": [
            {
              "value": "IA",
              "name": "t(data-access-amendment.default.I.A.title)"
            },
            {
              "value": "IB",
              "name": "t(data-access-amendment.default.I.B.title)"
            },
            {
              "value": "IC",
              "name": "t(data-access-amendment.default.I.C.title)"
            },
            {
              "value": "ID",
              "name": "t(data-access-amendment.default.I.D.title)"
            },
            {
              "value": "IE",
              "name": "t(data-access-amendment.default.I.E.title)"
            },
            {
              "value": "IF",
              "name": "t(data-access-amendment.default.I.F.title)"
            },
            {
              "value": "IG",
              "name": "t(data-access-amendment.default.I.G.title)"
            },
            {
              "value": "IH",
              "name": "t(data-access-amendment.default.I.H.title)"
            },
            {
              "value": "IIrdRebResearchProtocol",
              "name": "t(data-access-amendment.default.documents.reb-research-protocol)"
            },
            {
              "value": "IIrdRebDecisionLetter",
              "name": "t(data-access-amendment.default.documents.reb-decision-letter)"
            },
            {
              "value": "IIrdCV",
              "name": "t(data-access-amendment.default.documents.cv)t"
            },
            {
              "value": "IIrdPeerReview",
              "name": "t(data-access-amendment.default.documents.peer-review)"
            },
            {
              "value": "other",
              "name": "Other"
            }
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "condition": "model.modificationNature.indexOf('IA') > -1",
      "items": [
        {
          "type": "help",
          "helpvalue": "<h3>A. t(data-access-amendment.default.I.A.title)</h3><p class='help-block'>t(data-access-request.default.I.A.info)</p>"
        },
        {
          "type": "section",
          "htmlClass": "row",
          "items": [
            {
              "type": "section",
              "htmlClass": "col-xs-6",
              "items": [
                "name",
                "title",
                "position",
                "institution"
              ]
            },
            {
              "type": "section",
              "htmlClass": "col-xs-6",
              "items": [
                "email",
                "emailAlt",
                "phone",
                {
                  "key": "mailingAddress",
                  "type": "textarea"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "condition": "model.modificationNature.indexOf('IB') > -1",
      "items": [
        {
          "type": "help",
          "helpvalue": "<h3>B. t(data-access-amendment.default.I.B.title)</h3><p class='help-block'>t(data-access-amendment.default.I.B.info)</p>"
        },
        {
          "type": "section",
          "htmlClass": "row",
          "items": [
            {
              "type": "section",
              "htmlClass": "col-xs-6",
              "items": [
                "repName",
                "repTitle",
                "repPosition",
                "repInstitution"
              ]
            },
            {
              "type": "section",
              "htmlClass": "col-xs-6",
              "items": [
                "repEmail",
                "repPhone",
                {
                  "key": "repMailingAddress",
                  "type": "textarea"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "condition": "model.modificationNature.indexOf('IC') > -1",
      "items": [
        {
          "type": "help",
          "helpvalue": "<h3>C. t(data-access-amendment.default.I.C.title)</h3>"
        },
        {
          "key": "projectTitle",
          "notitle": true,
          "type": "textarea"
        },
        {
          "type": "section",
          "htmlClass": "row",
          "items": [
            {
              "type": "section",
              "htmlClass": "col-xs-6",
              "items": [
                {
                  "key": "projectWebsite",
                  "description": "t(data-access-amendment.default.I.C.website-help)"
                }
              ]
            },
            {
              "type": "section",
              "htmlClass": "col-xs-6",
              "items": []
            }
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "condition": "model.modificationNature.indexOf('ID') > -1",
      "items": [
        {
          "type": "help",
          "helpvalue": "<h3>D. t(data-access-amendment.default.I.D.title)</h3><p class='help-block'>t(data-access-amendment.default.I.D.info)</p>"
        },
        {
          "type": "section",
          "htmlClass": "row",
          "items": [
            {
              "type": "section",
              "htmlClass": "col-xs-6",
              "items": [
                "hasNoStaff",
                {
                  "key": "staff",
                  "add": "New",
                  "style": {
                    "add": "btn-info"
                  },
                  "notitle": true,
                  "items": [
                    "staff[].name",
                    "staff[].title",
                    "staff[].position",
                    "staff[].email"
                  ],
                  "condition": "!model.hasNoStaff"
                }
              ]
            },
            {
              "type": "section",
              "htmlClass": "col-xs-6",
              "items": []
            }
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "condition": "model.modificationNature.indexOf('IE') > -1",
      "items": [
        {
          "type": "help",
          "helpvalue": "<h3>E. t(data-access-amendment.default.I.E.title)</h3><p class='help-block'>t(data-access-amendment.default.I.E.info)</p>"
        },
        {
          "type": "section",
          "htmlClass": "row",
          "items": [
            {
              "type": "section",
              "htmlClass": "col-xs-6",
              "items": [
                "hasNoStudents",
                {
                  "key": "students",
                  "add": "New",
                  "style": {
                    "add": "btn-info"
                  },
                  "notitle": true,
                  "items": [
                    "students[].name",
                    "students[].title",
                    "students[].position",
                    "students[].email"
                  ],
                  "condition": "!model.hasNoStudents"
                }
              ]
            },
            {
              "type": "section",
              "htmlClass": "col-xs-6",
              "items": []
            }
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "condition": "model.modificationNature.indexOf('IF') > -1",
      "items": [
        {
          "type": "help",
          "helpvalue": "<h3>F. t(data-access-amendment.default.I.F.title)</h3><p class='help-block'>t(data-access-amendment.default.I.F.info)</p>"
        },
        {
          "key": "abstract",
          "notitle": true,
          "type": "textarea",
          "wordLimit": "0:500",
          "validationMessage": {
            "wordLimitError": "The 500 words limit has been exceeded."
          }
        }
      ]
    },
    {
      "type": "fieldset",
      "condition": "model.modificationNature.indexOf('IG') > -1",
      "items": [
        {
          "type": "help",
          "helpvalue": "<h3>G. t(data-access-amendment.default.I.G.title)</h3><p class='help-block'>t(data-access-amendment.default.I.G.info)</p>"
        },
        {
          "key": "summary",
          "notitle": true,
          "type": "textarea",
          "wordLimit": "0:200",
          "validationMessage": {
            "wordLimitError": "The 200 words limit has been exceeded."
          }
        }
      ]
    },
    {
      "type": "fieldset",
      "condition": "model.modificationNature.indexOf('IH') > -1",
      "items": [
        {
          "type": "help",
          "helpvalue": "<h3>G. t(data-access-amendment.default.I.H.title)</h3><p class='help-block'>t(data-access-amendment.default.I.H.info)</p>"
        },
        {
          "key": "endDate",
          "notitle": true,
          "dateOptions": {
            "dateFormat": "yyyy-MM-dd"
          },
          "validationMessage": "t(data-access-amendment.default.date-error)"
        }
      ]
    },
    {
      "type": "help",
      "helpvalue": "<h2>II - t(data-access-amendment.default.documents.title)</h2>",
      "condition": "model.modificationNature.indexOf('IIrdRebResearchProtocol') > -1 || model.modificationNature.indexOf('IIrdRebDecisionLetter') > -1 || model.modificationNature.indexOf('IIrdCV') > -1 || model.modificationNature.indexOf('IIrdPeerReview') > -1"
    },
    {
      "type": "fieldset",
      "items": [
        {
          "key": "rdRebResearchProtocol",
          "type": "obibaFileUpload",
          "condition": "model.modificationNature.indexOf('IIrdRebResearchProtocol') > -1",
          "validationMessage": {
            "missingFiles": "t(missing-files)",
            "minItems": "t(min-items)"
          },
          "emptyMessage": "t(data-access-request.no-documents)"
        },
        {
          "key": "rdRebDecisionLetter",
          "type": "obibaFileUpload",
          "condition": "model.modificationNature.indexOf('IIrdRebDecisionLetter') > -1",
          "validationMessage": {
            "missingFiles": "t(missing-files)",
            "minItems": "t(min-items)"
          },
          "emptyMessage": "t(data-access-request.no-documents)"
        },
        {
          "key": "rdCV",
          "type": "obibaFileUpload",
          "condition": "model.modificationNature.indexOf('IIrdCV') > -1",
          "validationMessage": {
            "missingFiles": "t(missing-files)",
            "minItems": "t(min-items)"
          },
          "emptyMessage": "t(data-access-request.no-documents)"
        },
        {
          "key": "rdPeerReview",
          "type": "obibaFileUpload",
          "condition": "model.modificationNature.indexOf('IIrdPeerReview') > -1",
          "validationMessage": {
            "missingFiles": "t(missing-files)",
            "minItems": "t(min-items)"
          },
          "emptyMessage": "t(data-access-request.no-documents)"
        }
      ]
    },
    {
      "type": "fieldset",
      "condition": "model.modificationNature.indexOf('other') > -1",
      "items": [
        {
          "key": "other",
          "type": "textarea",
          "rows": 5,
          "wordLimit": "0:500",
          "validationMessage": {
            "wordLimitError": "The 500 words limit has been exceeded."
          }
        }
      ]
    },
    {
      "type": "fieldset",
      "items": [
        {
          "type": "help",
          "helpvalue": "<h3>t(data-access-amendment.default.signature.title)</h3>"
        },
        "isFormCompleted"
      ]
    }
  ]
}
